 *
 * Overlay for ESP32-S2 Reverse TFT Feather
 * Uses UART0 on GPIO43/44 (DB pin) for console instead of GPIO1/2
 */

/* Enable ST7789V TFT Display */
&st7789v_tft {
	status = "okay";
};

/* Enable SPI2 for display */
&spi2 {
	status = "okay";
};

/*
 * UART Configuration for Reverse Board:
 * GPIO43 (DB pin) = UART0 TX - connects to ESP-Prog TXD0
 * GPIO44 = UART0 RX - connects to ESP-Prog RXD0 (if needed)
 *
 * Note: GPIO1 and GPIO2 are buttons on Reverse board, not UART!
 */
&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

/* Override console to use UART0 instead of UART1 */
/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};
};

/* Configure UART0 pins */
&pinctrl {
	uart0_default: uart0_default {
		group1 {
			pinmux = <UART0_TX_GPIO43>;
			output-high;
		};
		group2 {
			pinmux = <UART0_RX_GPIO44>;
			bias-pull-up;
		};
	};

	/* Override I2C0 pins to enable internal pull-ups */
	i2c0_default: i2c0_default {
		group1 {
			pinmux = <I2C0_SDA_GPIO3>,
				 <I2C0_SCL_GPIO4>;
			drive-open-drain;
			bias-pull-up;  /* Enable internal pull-up resistors */
		};
	};
};

/* Enable I2C for sensor support */
&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	/* BME280: Temperature/Humidity/Pressure at I2C address 0x77 */
	bme280@77 {
		compatible = "bosch,bme280";
		reg = <0x77>;
		status = "okay";
	};
};

/* Enable MAX17048 fuel gauge for battery monitoring */
&max17048 {
	status = "okay";
};
