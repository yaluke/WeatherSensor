/*
 * Copyright (c) 2026 Lukasz Ronka
 * SPDX-License-Identifier: Apache-2.0
 *
 * Overlay for ESP32-S2 Reverse TFT Feather
 * Uses UART0 on GPIO43/44 (DB pin) for console instead of GPIO1/2
 */

/*
 * Drop CPU from 240 MHz to 160 MHz to cut active-current draw. The
 * Zephyr-side esp32 module derives CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ
 * from this DT property. App is I/O-bound so the wall-clock impact
 * is negligible.
 */
&cpu0 {
	clock-frequency = <DT_FREQ_M(160)>;
};

/* Enable ST7789V TFT Display */
&st7789v_tft {
	status = "okay";
};

/* Enable SPI2 for display */
&spi2 {
	status = "okay";
};

/*
 * UART Configuration for Reverse Board:
 * GPIO43 (DB pin) = UART0 TX - connects to ESP-Prog TXD0
 * GPIO44 = UART0 RX - connects to ESP-Prog RXD0 (if needed)
 *
 * Note: GPIO1 and GPIO2 are buttons on Reverse board, not UART!
 */
&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

/* Override console to use UART0 instead of UART1 */
/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};
};

/* Configure UART0 pins */
&pinctrl {
	uart0_default: uart0_default {
		group1 {
			pinmux = <UART0_TX_GPIO43>;
			output-high;
		};
		group2 {
			pinmux = <UART0_RX_GPIO44>;
			bias-pull-up;
		};
	};

	/* Override I2C0 pins to enable internal pull-ups */
	i2c0_default: i2c0_default {
		group1 {
			pinmux = <I2C0_SDA_GPIO3>,
				 <I2C0_SCL_GPIO4>;
			drive-open-drain;
			bias-pull-up;  /* Enable internal pull-up resistors */
		};
	};
};

/* Enable I2C for sensor support */
&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	/* BME280: Temperature/Humidity/Pressure at I2C address 0x77 */
	bme280@77 {
		compatible = "bosch,bme280";
		reg = <0x77>;
		status = "okay";
	};
};

/* Enable MAX17048 fuel gauge for battery monitoring */
&max17048 {
	status = "okay";
};

/* Enable WiFi driver (Step 1) */
&wifi {
	status = "okay";
};

/*
 * Fix D1/D2 button polarity.
 * The upstream Zephyr board DTS incorrectly defines D1/D2 as GPIO_PULL_UP | GPIO_ACTIVE_LOW,
 * but per Adafruit docs these buttons are pulled LOW by default and go HIGH when pressed.
 * See: https://learn.adafruit.com/esp32-s2-reverse-tft-feather/pinouts
 */
/ {
	gpio_keys {
		/* 100 ms filter at the gpio-keys driver level. Still below the
		 * ~150 ms human-press threshold so real presses pass through
		 * unnoticeably late, but doubled from the original 50 ms after
		 * a second phantom D2 press slipped through. The app also
		 * applies an additional 80 ms hold filter — see button_input_cb. */
		debounce-interval-ms = <100>;

		d1_button: d1_button {
			gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
		};
		d2_button: d2_button {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		};
	};
};

/*
 * Power the external BME280 module's Vcc from GPIO8 (silk: A5).
 * Hogged HIGH at boot so the Zephyr BME280 driver's POST_KERNEL init —
 * which talks to the chip over I2C to read calibration coefficients —
 * sees a powered sensor. Once boot is done, the application toggles
 * this pin per-read in sensors_read() to keep the chip cold between
 * minute-spaced samples.
 */
&gpio0 {
	bme280_power_enable {
		gpio-hog;
		gpios = <8 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};
